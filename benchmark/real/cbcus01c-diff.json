    {
      "id": "unsorted-three",
      "stdin": [
        "000000030CAROL                                             THIRD                    1 HIGH ST                                                                                                                                             MAGBRSW1A1AA   +44200000000                  123456789PASSPORT            1980-01-01          Y600                                                                                                                                                                        ",
        "000000002BOB                                               SECOND                   1 HIGH ST                                                                                                                                             NYGBRSW1A1AA   +44200000000                  123456789PASSPORT            1980-01-01          Y810                                                                                                                                                                        ",
        "000000001ALICE                                             EXAMPLE                  1 HIGH ST                                                                                                                                             LNGBRSW1A1AA   +44200000000                  123456789PASSPORT            1980-01-01          Y750                                                                                                                                                                        "
      ]
    },
    {
